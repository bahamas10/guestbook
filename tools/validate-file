use strict;
use warnings;

use Encode qw(decode FB_CROAK);
use File::Basename qw(basename);
use FindBin qw($RealBin);

my $EMOJI_FILE = "$RealBin/../data/emoji-test.txt";

# see https://github.com/bahamas10/guestbook/issues/62
my %GRANDFATHERED = (
	'arch-err' => 1,
	'adrad1234' => 1,
);

# get file argument
if (@ARGV != 1) {
	usage();
	exit 2;
}
my $file = $ARGV[0];

sub usage {
	print STDERR "usage: validate-file ./contributors/<github-login>.txt\n";
}

sub fail {
	my ($message) = @_;
	print STDERR "FAIL: $file - $message\n";
	exit 1;
}

# load the Unicode emoji list
sub load_emojis {
	my %emojis;

	open my $fh, '<:encoding(UTF-8)', $EMOJI_FILE
	    or fail("cannot open emoji data: $!");

	local $/ = "\n";
	while (my $entry = <$fh>) {
		my ($points, $status) =
		    $entry =~ /\A([0-9A-F ]+)\s*;\s*([\w-]+)/;

		next unless defined $status;
		next unless $status eq 'fully-qualified'
		    || $status eq 'minimally-qualified'
		    || $status eq 'unqualified';

		my @points = split(' ', $points);
		my @characters = map { chr(hex($_)) } @points;
		my $value = join('', @characters);

		$emojis{$value} = 1;
	}

	close $fh or fail("cannot close emoji data: $!");

	# ensure we read *something*
	keys %emojis or fail('emoji data contains no accepted sequences');

	return %emojis;
}

my %emojis = load_emojis();

# ensure it is a regular file
-f $file or fail("not a regular file: $file");
-l $file and fail("symbolic links are not allowed: $file");

# get the username from the file
my $name = basename($file);
$name =~ /\.txt\z/ or fail('filename must end in .txt');
my $login = $name;
$login =~ s/\.txt\z//;

# validate github username
$login =~ /\A[a-z0-9][a-z0-9-]{0,38}\z/
    or fail('filename must contain a lowercase GitHub login');
$login !~ /--/ or fail('GitHub logins cannot contain consecutive hyphens');
$login !~ /-\z/ or fail('GitHub logins cannot end with a hyphen');

# read the file as raw bytes
open my $fh, '<:raw', $file or fail("cannot read $file: $!");
local $/;
my $bytes = <$fh>;
close $fh or fail("cannot close $file: $!");

# validate file max length
length($bytes) <= 1024 or fail('file must not exceed 1024 bytes');

# validate the file contents (not empty, 1 line, no \r)
length($bytes) > 0 && $bytes =~ /\n\z/ && $bytes !~ /\n./s
    or fail('file must contain exactly one newline-terminated line');
$bytes !~ /\r/ or fail('Windows-style CRLF line endings are not allowed');

# we have 1 line - decode it as UTF-8
my $line;
eval {
	$line = decode('UTF-8', substr($bytes, 0, -1), FB_CROAK);
	1;
} or fail('file must be valid UTF-8');

# parse the structure of the line with regex
my ($have_login, $symbol) =
    $line =~ /\A([^ ]+) [wW][aA][sS] [hH][eE][rR][eE] (.+)\z/s;
defined $symbol or fail('expected: <username> was here <char>');

# ensure the login we found in the file *looks* correct
$have_login =~ /\A[A-Za-z0-9-]+\z/
    or fail('username may contain only ASCII letters, numbers, and hyphens');

# ensure the username in the file matches the basename of the file
lc($have_login) eq $login
    or fail('username must match the lowercase filename (case-insensitive)');

# ensure only 1 visible grapheme is contained in the "symbol"
my @graphemes = $symbol =~ /\X/g;
@graphemes == 1 && $graphemes[0] eq $symbol
    or fail('the final item must be exactly one visible Unicode character');

# ensure the visible grapheme is *not* a control character
$symbol =~ /[^\p{Z}\p{C}]/
    or fail('the final character cannot be whitespace or a control character');

# check if the final "symbol" is a single character or single emoji.
unless (exists $GRANDFATHERED{$login}) {
	my $is_character = $symbol =~ /\A[\p{L}\p{N}\p{P}\p{S}]\z/
	    && $symbol !~ /\p{Default_Ignorable_Code_Point}/;
	my $is_emoji = exists $emojis{$symbol};
	($is_emoji || $is_character)
	    or fail("final symbol must be a single character or emoji");
}

# ok! at this point we are sure the file is valid (probably)
print "OK: $file\n";
